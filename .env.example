# Form destination only — never shown as public site copy.
# Official MT display email stays null in src/data/site.ts until provided.
PUBLIC_CONTACT_FORM_EMAIL=your-form-inbox@example.com

# Optional legacy alias (same as PUBLIC_CONTACT_FORM_EMAIL). Prefer the name above.
# PUBLIC_CONTACT_EMAIL=

# Optional: production site URL for canonical / form redirect.
# PUBLIC_SITE_URL=https://www.example.com
