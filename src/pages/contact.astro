---
import ContactForm from '../components/ContactForm.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StoreInfo from '../components/StoreInfo.astro';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description={`Contact MT Supermarket at ${site.address.street}, ${site.address.city}, ${site.address.region}. Phone ${site.phoneDisplay}. Expected opening ${site.opening}.`}
	schema
>
	<header class="page-header">
		<div class="container">
			<SectionHeader
				level="h1"
				eyebrow="Contact"
				title="Talk to the store"
				text="Send a message for store questions or wholesale inquiries. For hiring, you can also check Careers. Prefer the phone? Call the store."
			/>
		</div>
	</header>

	<section class="section contact-section" aria-labelledby="contact-form-heading">
		<div class="container contact-layout">
			<div class="contact-form-col">
				<h2 id="contact-form-heading">Send a message</h2>
				<ContactForm />
			</div>
			<div class="contact-info-col">
				<StoreInfo variant="panel" />
			</div>
		</div>
	</section>
</Layout>

<style>
	.contact-section {
		padding-top: 0.5rem;
	}

	.contact-layout {
		display: grid;
		gap: 2.5rem;
	}

	.contact-form-col h2 {
		margin-bottom: 0.35rem;
		font-size: clamp(1.85rem, 3vw, 2.45rem);
	}

	.contact-info-col :global(.section) {
		padding: 0;
	}

	.contact-info-col :global(h2) {
		font-size: clamp(1.85rem, 3vw, 2.45rem);
	}

	@media (min-width: 56rem) {
		.contact-layout {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 3rem;
			align-items: start;
		}
	}
</style>
