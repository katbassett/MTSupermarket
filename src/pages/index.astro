---
import CTASection from '../components/CTASection.astro';
import DepartmentGrid from '../components/DepartmentGrid.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import Photo from '../components/Photo.astro';
import { getActiveJobs } from '../lib/jobs';
import { photos } from '../data/images';
import { aisleLinks, discoveries } from '../data/market';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const openRoles = (await getActiveJobs()).length;
const signageItems = [
	'Asian & international groceries',
	'Fresh produce',
	'Seafood',
	'Meat',
	'Specialty foods',
];
---

<Layout
	title="MT Supermarket | Coming to San Antonio"
	description={site.description}
	fullTitle
	schema
>
	<section class="launch" aria-labelledby="home-heading">
		<div class="launch-frame">
			<figure class="launch-photo">
				<Photo
					src={photos.hero.src}
					alt={photos.hero.alt}
					sizes="(min-width: 64rem) 72vw, 100vw"
					loading="eager"
					fetchpriority="high"
					widths={[640, 960, 1200, 1600]}
				/>
			</figure>
			<div class="launch-panel">
				<p class="launch-kicker">Now coming to San Antonio</p>
				<h1 id="home-heading">
					A world of flavor,<br />
					all in one place.
				</h1>
				<p class="dek">
					Discover Asian and international groceries, fresh foods, everyday staples, and specialty
					ingredients—all under one roof.
				</p>
				<p class="launch-opening sign-label sign-label-yellow">Opening {site.opening}</p>
				<div class="launch-actions">
					<a class="launch-cta" href="#departments">Explore MT</a>
					<a class="hire-link" href="/careers">
						We're hiring
						<span class="arrow" aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<div class="signage">
		<ul class="container">
			{signageItems.map((item, index) => (
				<li data-reveal style={`--reveal-delay: ${index * 60}ms`}>{item}</li>
			))}
		</ul>
	</div>

	<section class="departments" id="departments" aria-labelledby="departments-heading">
		<div class="container">
			<p class="kicker" data-reveal>Shop the market</p>
			<h2 id="departments-heading" data-reveal style="--reveal-delay: 80ms">Explore our departments</h2>
			<DepartmentGrid />
		</div>
	</section>

	<nav class="aisles" aria-label="More to shop" data-reveal>
		<div class="container aisles-inner">
			<p>Also in the aisles</p>
			<ul>
				{
					aisleLinks.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>

	<section class="welcome" aria-labelledby="welcome-heading">
		<div class="container welcome-wrap">
			<figure data-reveal="left">
				<Photo
					src={photos.intro.src}
					alt={photos.intro.alt}
					sizes="(min-width: 56rem) 36rem, 100vw"
				/>
			</figure>
			<div data-reveal="right" style="--reveal-delay: 100ms">
				<p class="kicker">Welcome to MT</p>
				<h2 id="welcome-heading">More to discover in every aisle.</h2>
				<p>
					MT Supermarket is an established Asian and international supermarket, bringing grocery,
					produce, meat, seafood, and specialty ingredients to San Antonio.
				</p>
			</div>
		</div>
	</section>

	<section class="discover" aria-labelledby="discover-heading">
		<div class="container">
			<p class="kicker" data-reveal>Discover something new</p>
			<h2 id="discover-heading" data-reveal style="--reveal-delay: 70ms">
				Find something you didn't come looking for.
			</h2>
			<p class="discover-lead" data-reveal style="--reveal-delay: 120ms">
				Asian pantry staples, specialty ingredients, and products you won't necessarily find at a
				conventional supermarket.
			</p>
			<ul class="discover-grid">
				{
					discoveries.map((item, index) => (
						<li class={item.area} data-reveal style={`--reveal-delay: ${index * 70}ms`}>
							<a href={item.href}>
								<span class="discover-media">
									<Photo
										src={item.image}
										alt=""
										sizes={
											item.area === 'noodles'
												? '(min-width: 64rem) 40vw, 100vw'
												: '(min-width: 64rem) 22vw, 50vw'
										}
										widths={[480, 800, 1200]}
									/>
								</span>
								<span class="discover-name">{item.title}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="wholesale" aria-labelledby="wholesale-heading">
		<div class="container wholesale-wrap">
			<div class="wholesale-copy" data-reveal="left">
				<p class="sign-label sign-label-yellow">Cash &amp; carry</p>
				<h2 id="wholesale-heading">Wholesale for restaurants &amp; businesses.</h2>
				<p>
					A separate cash-and-carry wholesale operation serving restaurants and business customers.
				</p>
				<a href="/wholesale">Explore wholesale <span class="arrow" aria-hidden="true">→</span></a>
			</div>
			<figure data-reveal="right" style="--reveal-delay: 100ms">
				<Photo
					src={photos.wholesale.src}
					alt={photos.wholesale.alt}
					sizes="(min-width: 56rem) 40rem, 100vw"
				/>
			</figure>
		</div>
	</section>

	{/*
	  WEEKLY SPECIALS (future — Sanity-powered)
	  Reserved homepage location: after wholesale, before careers CTA.
	  When ready: render a section from `weeklySpecials` in src/data/features.ts
	  (or a Sanity query). Keep `weeklySpecials` empty until real specials exist.
	  Do not add Specials to primary nav until content is live.
	  FeatureStrip below is soft "Around the market" department teasers — not specials.
	*/}
	{/* {weeklySpecials.length > 0 && <WeeklySpecials items={weeklySpecials} />} */}

	<FeatureStrip />

	<CTASection
		eyebrow="Now hiring · San Antonio"
		title={'Join the MT\nSupermarket Team'}
		refreshHiringFromSanity={{ opening: site.opening, initialCount: openRoles }}
		cta={{ href: '/careers', label: 'View open positions' }}
	/>
</Layout>

<style>
	.welcome-wrap,
	.wholesale-wrap,
	.discover-grid {
		display: grid;
		min-width: 0;
	}

	.welcome-wrap > *,
	.wholesale-wrap > * {
		min-width: 0;
	}

	.kicker,
	.opening {
		color: var(--color-red);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.launch {
		padding: 0;
	}

	.launch-frame {
		position: relative;
		width: min(92rem, calc(100% - 1.25rem));
		margin-inline: auto;
	}

	.launch-photo {
		position: relative;
		width: 100%;
		margin: 0;
		overflow: hidden;
		aspect-ratio: 5 / 4;
		background: var(--color-paper-deep);
	}

	.launch-photo :global(img) {
		object-position: 68% 42%;
	}

	.launch-panel {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: calc(100% - 1rem);
		margin-top: -2.75rem;
		padding: clamp(1.25rem, 3.2vw, 1.75rem) clamp(0.85rem, 2vw, 1rem);
		border-radius: var(--radius-lg);
		background: var(--color-red);
		color: var(--color-cream);
		text-align: center;
	}

	.launch-kicker {
		color: var(--color-cream);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.launch-panel h1 {
		max-width: 10.5em;
		margin-top: 0.45rem;
		margin-inline: auto;
		color: var(--color-cream);
		font-size: clamp(2.15rem, 4.5vw, 2.7rem);
		line-height: 1.02;
	}

	.launch-panel .dek {
		max-width: 22rem;
		margin-top: 0.6rem;
		margin-inline: auto;
		color: var(--color-cream);
		font-size: 1.02rem;
	}

	.launch-opening {
		margin-top: 0.85rem;
	}

	.launch-cta {
		position: relative;
		isolation: isolate;
		display: inline-flex;
		align-items: center;
		overflow: hidden;
		min-height: 2.85rem;
		padding: 0.65rem 1.1rem;
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-red);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 0.35s ease;
	}

	.launch-cta::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: inherit;
		background: var(--color-blue);
		transform: translateX(-105%);
		transition: transform 0.45s ease;
	}

	.launch-cta:hover::before,
	.launch-cta:focus-visible::before {
		transform: translateX(0);
	}

	.launch-cta:hover,
	.launch-cta:focus-visible {
		color: var(--color-cream);
	}

	.launch-photo :global(img),
	.welcome figure :global(img),
	.wholesale figure :global(img),
	.discover-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.dek,
	.welcome p,
	.wholesale-copy p {
		max-width: 38rem;
		margin-top: 0.9rem;
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.launch-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.65rem 1.15rem;
		margin-top: 0.95rem;
	}

	.hire-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-cream);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.hire-link:hover,
	.hire-link:focus-visible {
		color: var(--color-blue);
	}

	.signage {
		background: var(--color-blue);
		color: var(--color-cream);
	}

	.signage ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.3rem 0.95rem;
		min-height: 2.25rem;
		padding: 0.3rem 0;
		list-style: none;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	@media (min-width: 52rem) {
		.signage ul {
			flex-wrap: nowrap;
			justify-content: space-between;
			gap: 1rem;
			padding: 0;
			font-size: 0.74rem;
			letter-spacing: 0.08em;
		}
	}

	@media (max-width: 63.99rem) {
		.launch-frame {
			width: 100%;
			margin-inline: 0;
		}

		.launch-photo {
			aspect-ratio: 3 / 4;
		}

		.launch-panel {
			position: absolute;
			top: 50%;
			left: 50%;
			width: min(78%, 17.25rem);
			margin-top: 0;
			padding: 1.2rem 0.72rem;
			transform: translate(-50%, -50%);
		}

		.launch-panel h1 {
			font-size: 1.9rem;
		}
	}

	.launch-photo {
		animation: hero-photo-in 2.2s ease both;
	}

	.launch-panel > * {
		animation: hero-line-in 1.25s ease both;
	}

	.launch-kicker {
		animation-delay: 0.45s;
	}

	.launch-panel h1 {
		animation-delay: 0.75s;
	}

	.launch-panel .dek {
		animation-delay: 1.05s;
	}

	.launch-opening {
		animation-delay: 1.3s;
	}

	.launch-actions {
		animation-delay: 1.55s;
	}

	@keyframes hero-photo-in {
		from {
			opacity: 0;
			transform: scale(1.035);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes hero-line-in {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	.departments {
		padding: clamp(2.75rem, 5.5vw, 4.25rem) 0 1.5rem;
	}

	.departments h2 {
		margin-top: 0.4rem;
		margin-bottom: 1.35rem;
		font-size: clamp(1.8rem, 2.6vw, 2.35rem);
		line-height: 1.05;
	}

	.aisles {
		background: var(--color-surface);
		border-block: 1px solid var(--color-line);
		padding: 0.85rem 0;
	}

	.aisles-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.25rem;
	}

	.aisles p {
		margin: 0;
		color: var(--color-red);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.aisles ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.aisles li {
		display: flex;
		align-items: center;
	}

	.aisles li:not(:last-child)::after {
		content: '';
		width: 1px;
		height: 0.8rem;
		margin-inline: 0.7rem;
		background: var(--color-line);
	}

	.aisles a {
		font-size: 0.98rem;
		font-weight: 800;
		text-decoration: none;
	}

	.aisles a:hover,
	.aisles a:focus-visible {
		color: var(--color-red);
	}

	.welcome {
		background: var(--color-warm);
		padding: clamp(2.25rem, 4.5vw, 3.75rem) 0;
	}

	.welcome-wrap,
	.wholesale-wrap {
		gap: 1.35rem;
		align-items: center;
	}

	.welcome figure,
	.wholesale figure,
	.discover-media {
		position: relative;
		margin: 0;
		overflow: hidden;
		background: var(--color-paper-deep);
	}

	.welcome figure,
	.wholesale figure {
		aspect-ratio: 4 / 3;
	}

	.welcome h2,
	.discover h2,
	.wholesale h2 {
		margin-top: 0.4rem;
		font-size: clamp(1.75rem, 2.4vw, 2.2rem);
		line-height: 1.08;
	}

	.welcome h2 {
		max-width: 16ch;
	}

	.discover {
		padding: clamp(1.75rem, 3.5vw, 2.75rem) 0 clamp(1.5rem, 3vw, 2.35rem);
	}

	.discover-lead {
		max-width: 36rem;
		margin-top: 0.4rem;
		font-size: 1.02rem;
	}

	.discover-grid {
		grid-template-columns: 1fr 1fr;
		gap: 0.55rem 0.5rem;
		margin: 0.95rem 0 0;
		padding: 0;
		list-style: none;
	}

	.discover-grid li {
		min-width: 0;
	}

	.noodles {
		grid-column: 1 / -1;
	}

	.discover-grid a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.discover-media {
		display: block;
		aspect-ratio: 5 / 4;
	}

	.noodles .discover-media {
		aspect-ratio: 16 / 9;
	}

	.discover-name {
		display: inline-block;
		margin-top: 0.3rem;
		background-image: linear-gradient(currentColor, currentColor);
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 0 1px;
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.2;
		transition: background-size 0.25s ease;
	}

	.discover-media :global(img) {
		transition: transform 0.45s ease;
	}

	.noodles .discover-media :global(img) {
		object-position: center 62%;
	}

	.snacks .discover-media :global(img) {
		object-position: center 58%;
	}

	.drinks .discover-media :global(img) {
		object-position: center 42%;
	}

	.pantry .discover-media :global(img) {
		object-position: center 45%;
	}

	.frozen .discover-media :global(img) {
		object-position: center 50%;
	}

	.specialty .discover-media :global(img) {
		object-position: center 40%;
	}

	.discover-grid a:hover .discover-media :global(img),
	.discover-grid a:focus-visible .discover-media :global(img) {
		transform: scale(1.04);
	}

	.discover-grid a:hover .discover-name,
	.discover-grid a:focus-visible .discover-name {
		background-size: 100% 1px;
	}

	.wholesale {
		padding: clamp(1.75rem, 4vw, 3rem) 0 clamp(2rem, 4vw, 3.25rem);
		border-top: 1px solid var(--color-line);
	}

	.wholesale-copy .sign-label {
		margin-bottom: 0.75rem;
	}

	.wholesale-copy h2 {
		max-width: 18ch;
		margin-top: 0;
	}

	.wholesale-copy a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1rem;
		color: var(--color-red);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.hire-link:hover .arrow,
	.hire-link:focus-visible .arrow,
	.wholesale-copy a:hover .arrow,
	.wholesale-copy a:focus-visible .arrow {
		transform: translateX(0.28rem);
	}

	@media (min-width: 64rem) {
		.launch-frame {
			--panel: 36%;
			--overlap: clamp(4rem, 5.5vw, 7.5rem);
		}

		.launch-photo {
			width: calc(100% - var(--panel) + var(--overlap));
			margin-left: auto;
			aspect-ratio: 16 / 9;
		}

		.launch-panel {
			position: absolute;
			top: 50%;
			bottom: auto;
			left: 0;
			width: var(--panel);
			max-width: 36%;
			margin-top: 0;
			padding: clamp(1.35rem, 1.65vw, 1.85rem) clamp(0.85rem, 1vw, 1rem);
			transform: translateY(-50%);
		}

		.launch-panel h1 {
			font-size: clamp(2.2rem, 2.35vw, 2.75rem);
		}

		.welcome-wrap {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 2.75rem;
		}

		.discover-grid {
			grid-template-columns: 1.25fr 0.75fr 0.75fr 0.75fr;
			grid-template-rows: 12.5rem 12.5rem 11rem;
			grid-template-areas:
				'noodles noodles snacks drinks'
				'noodles noodles sauces pantry'
				'frozen specialty specialty specialty';
			gap: 0.7rem 0.55rem;
		}

		.discover-grid a {
			display: flex;
			flex-direction: column;
			height: 100%;
		}

		.noodles {
			grid-area: noodles;
		}

		.snacks {
			grid-area: snacks;
		}

		.drinks {
			grid-area: drinks;
		}

		.pantry {
			grid-area: pantry;
		}

		.sauces {
			grid-area: sauces;
		}

		.frozen {
			grid-area: frozen;
		}

		.specialty {
			grid-area: specialty;
		}

		.discover-media {
			flex: 1;
			aspect-ratio: auto;
			min-height: 0;
		}

		.wholesale-wrap {
			grid-template-columns: 0.9fr 1.1fr;
			gap: 2.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow,
		.discover-media :global(img),
		.discover-name,
		.launch-photo,
		.launch-panel > * {
			transition: none;
			animation: none;
		}

		.hire-link:hover .arrow,
		.hire-link:focus-visible .arrow,
		.wholesale-copy a:hover .arrow,
		.wholesale-copy a:focus-visible .arrow,
		.discover-grid a:hover .discover-media :global(img),
		.discover-grid a:focus-visible .discover-media :global(img) {
			transform: none;
		}
	}
</style>
