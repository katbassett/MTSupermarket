---
import CTASection from '../components/CTASection.astro';
import DepartmentGrid from '../components/DepartmentGrid.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import Photo from '../components/Photo.astro';
import { getActiveJobs } from '../data/jobs';
import { photos } from '../data/images';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const openRoles = getActiveJobs().length;
const quickLinks = [
	{ kicker: 'Visit us', label: site.address.street, href: site.mapsUrl },
	{ kicker: 'Store hours', label: `${site.hoursLabel} daily`, href: '/contact' },
	{ kicker: 'Explore', label: 'Departments', href: '/departments' },
	{ kicker: 'Careers', label: 'Now hiring', href: '/careers' },
];
const finds: {
	title: string;
	href: string;
	image?: (typeof photos)[keyof typeof photos]['src'];
	tone?: 'yellow' | 'green';
	mark?: string;
}[] = [
	{ title: 'Fresh Produce', href: '/departments/produce', image: photos.produce.src },
	{ title: 'Live & Fresh Seafood', href: '/departments/seafood', image: photos.seafood.src },
	{ title: 'Specialty Meat Cuts', href: '/departments/meat', image: photos.meat.src },
	{ title: 'Asian Pantry Staples', href: '/departments/grocery', image: photos.grocery.src },
	{ title: 'Frozen Foods', href: '/departments/grocery', tone: 'yellow', mark: 'Frozen' },
	{ title: 'Snacks & Beverages', href: '/departments/grocery', tone: 'green', mark: 'Snacks' },
];
---

<Layout
	title="MT Supermarket | Coming to San Antonio"
	description={site.description}
	fullTitle
	schema
>
	<section class="launch" aria-labelledby="home-heading">
		<figure class="launch-photo">
			<Photo
				src={photos.hero.src}
				alt={photos.hero.alt}
				sizes="(min-width: 64rem) 58vw, 100vw"
				loading="eager"
				fetchpriority="high"
				widths={[640, 960, 1200, 1600]}
			/>
		</figure>
		<div class="launch-copy">
			<div class="launch-inner">
				<p class="launch-kicker">Now coming to San Antonio</p>
				<h1 id="home-heading">
					A world of flavor,<br />
					all in one place.
				</h1>
				<p class="launch-dek">
					MT Supermarket brings international ingredients, fresh foods, everyday staples, and
					specialty products to San Antonio.
				</p>
				<p class="opening">Opening {site.opening}</p>
				<div class="launch-actions">
					<a class="button button-primary" href="#departments">Explore MT</a>
					<a class="button button-secondary" href="/careers">We're hiring</a>
				</div>
			</div>
		</div>
	</section>

	<nav class="quick" aria-label="Store">
		<ul class="container">
			{
				quickLinks.map((item) => (
					<li>
						<a href={item.href}>
							<span class="quick-kicker">{item.kicker}</span>
							<span class="quick-label">{item.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<section class="departments" id="departments" aria-labelledby="departments-heading">
		<div class="container">
			<h2 id="departments-heading">Explore our departments</h2>
			<DepartmentGrid />
		</div>
	</section>

	<section class="welcome" aria-labelledby="welcome-heading">
		<div class="container welcome-wrap">
			<figure>
				<Photo
					src={photos.intro.src}
					alt={photos.intro.alt}
					sizes="(min-width: 56rem) 36rem, 100vw"
				/>
			</figure>
			<div>
				<p class="welcome-kicker">Welcome to MT</p>
				<h2 id="welcome-heading">More to discover in every aisle.</h2>
				<p>
					MT Supermarket is an established Asian and international supermarket, bringing variety
					and specialty products to San Antonio.
				</p>
			</div>
		</div>
	</section>

	<section class="find" aria-labelledby="find-heading">
		<div class="container">
			<p class="find-kicker">Find something you didn't come looking for.</p>
			<h2 id="find-heading">What you'll find at MT</h2>
			<ul class="find-grid">
				{
					finds.map((item) => (
						<li>
							<a href={item.href}>
								<span class:list={['find-media', item.tone]}>
									{item.image && (
										<Photo src={item.image} alt="" sizes="(min-width: 64rem) 16vw, 50vw" widths={[320, 480, 720]} />
									)}
									{item.mark && <span class="find-mark">{item.mark}</span>}
								</span>
								<span class="find-name">{item.title}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="wholesale" aria-labelledby="wholesale-heading">
		<div class="container wholesale-wrap">
			<figure>
				<Photo
					src={photos.wholesale.src}
					alt={photos.wholesale.alt}
					sizes="(min-width: 56rem) 36rem, 100vw"
				/>
			</figure>
			<div class="wholesale-copy">
				<p class="wholesale-kicker">Cash &amp; carry</p>
				<h2 id="wholesale-heading">Wholesale for restaurants &amp; businesses.</h2>
				<p>
					MT serves restaurants and businesses through its cash-and-carry wholesale operation.
				</p>
				<a href="/wholesale">Explore wholesale <span class="arrow" aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<FeatureStrip />

	<CTASection
		eyebrow="Now hiring · San Antonio"
		title={'Join the MT\nSupermarket Team'}
		text={openRoles > 0
			? `Hiring for the San Antonio store is open before the expected ${site.opening.toLowerCase()} opening. ${openRoles} positions are listed.`
			: 'Hiring for the San Antonio store begins before the store opens.'}
		cta={{ href: '/careers', label: 'View open positions' }}
	/>
</Layout>

<style>
	.launch,
	.welcome-wrap,
	.wholesale-wrap,
	.find-grid {
		display: grid;
		min-width: 0;
	}

	.launch > *,
	.welcome-wrap > *,
	.wholesale-wrap > * {
		min-width: 0;
	}

	.launch-photo {
		position: relative;
		margin: 0;
		min-height: 16rem;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: var(--color-paper-deep);
	}

	.launch-photo :global(img),
	.welcome figure :global(img),
	.wholesale figure :global(img),
	.find-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.launch-copy {
		display: flex;
		align-items: center;
		padding: clamp(1.75rem, 4vw, 2.5rem) 0;
	}

	.launch-inner {
		width: min(34rem, calc(100% - 2rem));
		margin-inline: auto;
	}

	.launch-kicker,
	.welcome-kicker,
	.wholesale-kicker,
	.find-kicker,
	.opening,
	.launch-actions .button {
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.launch-kicker,
	.welcome-kicker,
	.wholesale-kicker {
		color: var(--color-red);
		font-size: 0.75rem;
	}

	h1 {
		max-width: 12ch;
		margin-top: 0.7rem;
		font-size: clamp(2.6rem, 4.8vw, 4.35rem);
		line-height: 0.96;
	}

	.launch-dek,
	.welcome p,
	.wholesale-copy p {
		max-width: 34rem;
		margin-top: 1rem;
		font-size: 1.08rem;
		line-height: 1.5;
	}

	.opening {
		display: inline-block;
		margin-top: 1.15rem;
		padding-bottom: 0.2rem;
		border-bottom: 3px solid var(--color-yellow);
		font-size: 0.78rem;
	}

	.launch-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.35rem;
	}

	.launch-actions .button {
		font-size: 0.82rem;
	}

	.quick {
		background: var(--color-surface);
		border-block: 1px solid var(--color-line);
	}

	.quick ul {
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.quick li {
		min-width: 0;
	}

	.quick li:nth-child(even) {
		border-left: 1px solid var(--color-line);
	}

	.quick li:nth-child(n + 3) {
		border-top: 1px solid var(--color-line);
	}

	.quick a {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 4.75rem;
		padding: 0.85rem 1rem;
		text-decoration: none;
	}

	.quick-kicker {
		color: var(--color-red);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.quick-label {
		margin-top: 0.15rem;
		font-weight: 700;
	}

	.quick a:hover .quick-label,
	.quick a:focus-visible .quick-label {
		color: var(--color-red);
	}

	.departments,
	.wholesale {
		padding: clamp(2.5rem, 5vw, 4rem) 0;
	}

	.departments h2,
	.welcome h2,
	.find h2,
	.wholesale h2 {
		max-width: 16ch;
		font-size: clamp(1.9rem, 3.2vw, 2.65rem);
		line-height: 1.02;
	}

	.departments h2 {
		margin-bottom: 1.5rem;
	}

	.welcome {
		background: var(--color-warm);
		padding: clamp(2.5rem, 5vw, 4rem) 0;
	}

	.welcome-wrap,
	.wholesale-wrap {
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}

	.welcome figure,
	.wholesale figure,
	.find-media {
		position: relative;
	}

	.welcome figure,
	.wholesale figure {
		margin: 0;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: var(--color-paper-deep);
	}

	.welcome h2,
	.wholesale h2 {
		margin-top: 0.55rem;
	}

	.find {
		background: var(--color-red);
		color: var(--color-bg);
		padding: clamp(2.5rem, 5vw, 4rem) 0;
	}

	.find-kicker {
		max-width: 22rem;
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.find h2 {
		max-width: none;
		margin-top: 0.7rem;
	}

	.find-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.15rem 0.85rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.find-grid a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.find-media {
		display: block;
		overflow: hidden;
		aspect-ratio: 1;
		background: rgb(255 255 255 / 12%);
	}

	.find-media.yellow {
		background: var(--color-yellow);
		color: var(--color-ink);
	}

	.find-media.green {
		background: var(--color-green);
		color: var(--color-bg);
	}

	.find-mark {
		display: flex;
		align-items: flex-end;
		height: 100%;
		padding: 0.7rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.find-name {
		display: block;
		margin-top: 0.55rem;
		font-size: 0.95rem;
		font-weight: 800;
		line-height: 1.25;
	}

	.find-grid a:hover .find-name,
	.find-grid a:focus-visible .find-name {
		color: var(--color-yellow);
	}

	.wholesale-copy a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.1rem;
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.wholesale-copy a:hover,
	.wholesale-copy a:focus-visible {
		color: var(--color-red);
	}

	.wholesale-copy a:hover .arrow,
	.wholesale-copy a:focus-visible .arrow {
		transform: translateX(0.28rem);
	}

	@media (min-width: 48rem) {
		.quick ul {
			grid-template-columns: repeat(4, 1fr);
		}

		.quick li {
			border-top: 0;
			border-left: 1px solid var(--color-line);
		}

		.quick li:first-child {
			border-left: 0;
		}

		.find-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.launch {
			grid-template-columns: minmax(20rem, 0.86fr) 1.14fr;
			min-height: 34rem;
		}

		.launch-photo {
			order: 2;
			aspect-ratio: auto;
			height: 100%;
			min-height: 34rem;
		}

		.launch-copy {
			padding: 2.5rem 0;
		}

		.launch-inner {
			width: min(32rem, 100%);
			margin-left: max(1rem, calc((100vw - 72rem) / 2));
			margin-right: 2rem;
		}

		.welcome-wrap,
		.wholesale-wrap {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 3rem;
		}

		.find-grid {
			grid-template-columns: repeat(6, 1fr);
			gap: 1rem 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow {
			transition: none;
		}

		.wholesale-copy a:hover .arrow,
		.wholesale-copy a:focus-visible .arrow {
			transform: none;
		}
	}
</style>
