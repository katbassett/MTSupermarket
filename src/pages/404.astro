---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="That page is not on the MT Supermarket site.">
	<header class="page-header">
		<div class="container prose">
			<h1>Page not found</h1>
			<p class="lede">That address is not on this site.</p>
			<div class="button-row">
				<a class="button button-primary" href="/">Back to home</a>
				<a class="button button-secondary" href="/contact">Contact</a>
			</div>
		</div>
	</header>
</Layout>

<style>
	h1 {
		font-size: clamp(2.7rem, 6vw, 4.6rem);
	}

	.page-header {
		padding-bottom: 4rem;
	}
</style>
