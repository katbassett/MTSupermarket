---
import type {SanityJob} from '../lib/jobs'

interface Props {
	job: SanityJob
}

const {job} = Astro.props
---

<article class="job-card">
	<div>
		<h3>
			<a href={`/careers/${job.slug}`}>{job.title}</a>
		</h3>
		<p class="meta">{[job.location, job.employmentType].filter(Boolean).join(' · ')}</p>
		{job.summary && <p>{job.summary}</p>}
	</div>
	<a class="view-link" href={`/careers/${job.slug}`}>
		View position
		<span class="arrow" aria-hidden="true">→</span>
	</a>
</article>

<style>
	.job-card {
		display: grid;
		gap: 1rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--color-line);
	}

	.job-card:last-child {
		border-bottom: 1px solid var(--color-line);
	}

	h3 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}

	h3 a {
		color: inherit;
		text-decoration: none;
	}

	h3 a:hover,
	h3 a:focus-visible {
		color: var(--color-red);
	}

	.meta {
		margin-top: 0.35rem;
		font-size: 0.92rem;
		font-weight: 700;
	}

	p {
		max-width: 42rem;
		margin-top: 0.45rem;
		color: var(--color-muted);
	}

	.view-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		align-self: start;
		color: var(--color-red);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.view-link:hover .arrow,
	.view-link:focus-visible .arrow {
		transform: translateX(0.28rem);
	}

	@media (min-width: 48rem) {
		.job-card {
			grid-template-columns: 1fr auto;
			align-items: end;
			gap: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow {
			transition: none;
		}

		.view-link:hover .arrow,
		.view-link:focus-visible .arrow {
			transform: none;
		}
	}
</style>
