---
import type { Department } from '../data/departments';
import Photo from './Photo.astro';

interface Props {
	department: Department;
}

const { department } = Astro.props;
---

<a class:list={['dept-tile', department.slug]} href={`/departments/${department.slug}`}>
	<span class="dept-media">
		<Photo
			src={department.image}
			alt=""
			sizes="(min-width: 48rem) 36vw, 100vw"
			widths={[480, 720, 960, 1200]}
		/>
	</span>
	<span class="dept-name">{department.name}</span>
	<span class="dept-summary">{department.summary}</span>
	<span class="dept-go">Explore <span class="arrow" aria-hidden="true">→</span></span>
</a>

<style>
	.dept-tile {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.dept-media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		background: var(--color-paper-deep);
	}

	.dept-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.produce :global(img) {
		object-position: center 30%;
	}

	.seafood :global(img) {
		object-position: center 70%;
	}

	.meat :global(img) {
		object-position: center 40%;
	}

	.grocery :global(img) {
		object-position: center 45%;
	}

	.dept-name {
		display: inline-block;
		margin-top: 0.8rem;
		background-image: linear-gradient(currentColor, currentColor);
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 0 1px;
		font-family: var(--font-display-stack);
		font-size: clamp(1.45rem, 1.8vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
		transition: background-size 0.25s ease;
	}

	.dept-summary {
		display: block;
		max-width: 36rem;
		margin-top: 0.35rem;
		color: var(--color-ink-soft);
		font-size: 1rem;
		line-height: 1.4;
	}

	.dept-go {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.55rem;
		color: var(--color-red);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.dept-tile:hover .dept-media :global(img),
	.dept-tile:focus-visible .dept-media :global(img) {
		transform: scale(1.04);
	}

	.dept-tile:hover .dept-name,
	.dept-tile:focus-visible .dept-name {
		background-size: 100% 1px;
	}

	.dept-tile:hover .arrow,
	.dept-tile:focus-visible .arrow {
		transform: translateX(0.3rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.dept-media :global(img),
		.dept-name,
		.arrow {
			transition: none;
		}

		.dept-tile:hover .dept-media :global(img),
		.dept-tile:focus-visible .dept-media :global(img),
		.dept-tile:hover .arrow,
		.dept-tile:focus-visible .arrow {
			transform: none;
		}
	}
</style>
