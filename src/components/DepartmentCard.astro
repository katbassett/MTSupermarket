---
import type { Department } from '../data/departments';
import Photo from './Photo.astro';

interface Props {
	department: Department;
}

const { department } = Astro.props;
const isFresh = department.slug === 'produce' || department.slug === 'seafood';
---

<a class:list={['dept-tile', { 'is-fresh': isFresh }]} href={`/departments/${department.slug}`}>
	<span class="dept-media">
		<Photo
			src={department.image}
			alt=""
			sizes="(min-width: 48rem) 36vw, 100vw"
			widths={[480, 720, 960, 1200]}
		/>
	</span>
	<span class="dept-name">{department.name}</span>
	<span class="dept-go">{department.cardLine} <span class="arrow" aria-hidden="true">→</span></span>
</a>

<style>
	.dept-tile {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.dept-media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		background: var(--color-paper-deep);
	}

	.dept-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.dept-name {
		display: block;
		margin-top: 0.85rem;
		font-family: var(--font-display-stack);
		font-size: clamp(1.55rem, 2vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.dept-go {
		display: inline-block;
		margin-top: 0.4rem;
		color: var(--color-muted);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.is-fresh .dept-go {
		color: var(--color-green);
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.dept-tile:hover .dept-media :global(img),
	.dept-tile:focus-visible .dept-media :global(img) {
		transform: scale(1.03);
	}

	.dept-tile:hover .dept-go,
	.dept-tile:focus-visible .dept-go {
		color: var(--color-red);
	}

	.dept-tile:hover .arrow,
	.dept-tile:focus-visible .arrow {
		transform: translateX(0.28rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.dept-media :global(img),
		.arrow {
			transition: none;
		}

		.dept-tile:hover .dept-media :global(img),
		.dept-tile:focus-visible .dept-media :global(img),
		.dept-tile:hover .arrow,
		.dept-tile:focus-visible .arrow {
			transform: none;
		}
	}
</style>
