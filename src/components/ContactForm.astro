---
import { site } from '../data/site';

/**
 * Posts to FormSubmit → site.email (kat@lionheartgraphix.com for now).
 * Override with PUBLIC_CONTACT_EMAIL in `.env` when the store address is ready.
 */
const contactEmail = site.email;
const sent = Astro.url.searchParams.get('sent') === '1';
const siteBase =
	(import.meta.env.PUBLIC_SITE_URL as string | undefined) ||
	Astro.site?.href ||
	Astro.url.origin;
const nextUrl = new URL('/contact?sent=1', siteBase).href;
---

{
	sent ? (
		<div class="form-status form-status-ok" role="status">
			<p class="sign-label sign-label-yellow">Message sent</p>
			<p>Thanks — we received your note. For anything urgent, call the store.</p>
			<p>
				<a href="/contact">Send another message</a>
			</p>
		</div>
	) : contactEmail ? (
		<form
			class="contact-form"
			action={`https://formsubmit.co/${contactEmail}`}
			method="POST"
		>
			<input type="hidden" name="_subject" value="MT Supermarket website inquiry" />
			<input type="hidden" name="_next" value={nextUrl} />
			<input type="hidden" name="_template" value="table" />
			<input type="hidden" name="_captcha" value="false" />
			{/* Honeypot — leave empty */}
			<input class="hp" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<div class="field">
				<label for="contact-name">Name</label>
				<input id="contact-name" name="name" type="text" required autocomplete="name" />
			</div>

			<div class="field-row">
				<div class="field">
					<label for="contact-email">Email</label>
					<input id="contact-email" name="email" type="email" required autocomplete="email" />
				</div>
				<div class="field">
					<label for="contact-phone">Phone <span class="optional">(optional)</span></label>
					<input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
				</div>
			</div>

			<div class="field">
				<label for="contact-topic">Topic</label>
				<select id="contact-topic" name="topic" required>
					<option value="" disabled selected>
						Select a topic
					</option>
					<option value="Store question">Store question</option>
					<option value="Wholesale">Wholesale</option>
					<option value="Careers">Careers</option>
					<option value="Other">Other</option>
				</select>
			</div>

			<div class="field">
				<label for="contact-message">Message</label>
				<textarea id="contact-message" name="message" rows="5" required />
			</div>

			<button class="button button-primary" type="submit">Send message</button>
			<p class="form-note">Or call the store if you need a faster answer.</p>
		</form>
	) : (
		<div class="form-status" role="status">
			<p class="sign-label sign-label-red">Form setup needed</p>
			<p>
				Add <code>PUBLIC_CONTACT_EMAIL</code> to the project <code>.env</code> so messages can be
				delivered. Until then, call the store for questions.
			</p>
		</div>
	)
}

<style>
	.contact-form,
	.form-status {
		max-width: 36rem;
	}

	.form-status {
		padding: 1.25rem 1.15rem;
		border: 2px solid var(--color-ink);
		background: var(--color-warm);
	}

	.form-status-ok {
		border-color: var(--color-red);
		background: var(--color-cream);
	}

	.form-status p + p {
		margin-top: 0.75rem;
	}

	.form-status a {
		color: var(--color-red);
		font-weight: 800;
	}

	.form-status code {
		font-size: 0.9em;
		font-weight: 700;
	}

	.hp {
		position: absolute;
		left: -9999px;
		height: 0;
		overflow: hidden;
		opacity: 0;
	}

	.field {
		display: grid;
		gap: 0.4rem;
		margin-top: 1rem;
	}

	.field-row {
		display: grid;
		gap: 0 1rem;
	}

	label {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.optional {
		color: var(--color-muted);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: none;
	}

	input,
	select,
	textarea {
		width: 100%;
		min-height: 2.85rem;
		padding: 0.65rem 0.75rem;
		border: 2px solid var(--color-ink);
		border-radius: 0;
		background: var(--color-surface);
		color: var(--color-ink);
		font: inherit;
	}

	textarea {
		min-height: 8rem;
		resize: vertical;
	}

	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 3px solid var(--color-yellow);
		outline-offset: 2px;
	}

	button[type='submit'] {
		margin-top: 1.25rem;
		width: 100%;
		cursor: pointer;
		border: 0;
		font-family: inherit;
	}

	.form-note {
		margin-top: 0.85rem;
		color: var(--color-muted);
		font-size: 0.92rem;
	}

	@media (min-width: 40rem) {
		.field-row {
			grid-template-columns: 1fr 1fr;
		}

		button[type='submit'] {
			width: auto;
			min-width: 12rem;
		}
	}
</style>
