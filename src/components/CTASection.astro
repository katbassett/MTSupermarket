---
import { formatHiringCtaText } from '../lib/hiring-copy';
import { sanityApiVersion, sanityDataset, sanityProjectId } from '../lib/sanity';

interface Props {
	eyebrow?: string;
	title: string;
	text?: string;
	/** When set, body copy refreshes from Sanity on each page load (public API). */
	refreshHiringFromSanity?: { opening: string; initialCount: number };
	cta: { href: string; label: string };
}

const { eyebrow, title, text, refreshHiringFromSanity, cta } = Astro.props;
const titleLines = title.split('\n');
const ctaLines = cta.label.split('\n');
const hiringText =
	refreshHiringFromSanity &&
	formatHiringCtaText(refreshHiringFromSanity.initialCount, refreshHiringFromSanity.opening);
---

<section class="cta-band" data-reveal="fade">
	<div class="cta-main">
		{eyebrow && <p class="cta-label">{eyebrow}</p>}
		<h2>
			{
				titleLines.map((line, index) => (
					<>
						{index > 0 && <br />}
						{line}
					</>
				))
			}
		</h2>
		{refreshHiringFromSanity && hiringText ? (
			<p data-careers-cta-text>{hiringText}</p>
		) : (
			text && <p>{text}</p>
		)}
	</div>
	<a class="cta-go" href={cta.href}>
		<span>
			{
				ctaLines.map((line, index) => (
					<>
						{index > 0 && <br />}
						{line}
					</>
				))
			}
			<span class="arrow" aria-hidden="true"> →</span>
		</span>
	</a>
</section>

{
	refreshHiringFromSanity && (
		<script
			define:vars={{
				projectId: sanityProjectId,
				dataset: sanityDataset,
				apiVersion: sanityApiVersion,
				opening: refreshHiringFromSanity.opening,
			}}
		>
			(function () {
				const el = document.querySelector('[data-careers-cta-text]');
				if (!el) return;

				const query =
					'count(*[_type == "job" && active == true && defined(slug.current)])';

				function format(count) {
					const openingLabel = opening.toLowerCase();
					if (count > 0) {
						const positionPhrase =
							count === 1 ? '1 position is listed' : count + ' positions are listed';
						return (
							'Hiring for the San Antonio store is open before the expected ' +
							openingLabel +
							' opening. ' +
							positionPhrase +
							'.'
						);
					}
					return 'Hiring for the San Antonio store begins before the store opens.';
				}

				const url =
					'https://' +
					projectId +
					'.apicdn.sanity.io/v' +
					apiVersion +
					'/data/query/' +
					dataset +
					'?query=' +
					encodeURIComponent(query);

				fetch(url)
					.then((res) => res.json())
					.then((data) => {
						const count = typeof data.result === 'number' ? data.result : 0;
						el.textContent = format(count);
					})
					.catch(() => {
						/* Keep build-time copy on failure */
					});
			})();
		</script>
	)
}

<style>
	.cta-band {
		display: grid;
	}

	.cta-main {
		background: var(--color-warm);
		color: var(--color-ink);
		padding: clamp(2.25rem, 6vw, 4.25rem) max(1.25rem, calc((100% - 72rem) / 2));
	}

	.cta-label {
		margin-bottom: 0.85rem;
		color: var(--color-red);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h2 {
		max-width: 14ch;
		color: var(--color-red);
		font-size: clamp(2.35rem, 4vw, 3.5rem);
		line-height: 0.95;
	}

	.cta-main > p:last-child {
		max-width: 32rem;
		margin-top: 1rem;
		font-size: 1.12rem;
	}

	.cta-go {
		display: flex;
		align-items: flex-end;
		background: var(--color-accent);
		color: var(--color-paper);
		padding: 1.6rem max(1.25rem, calc((100% - 72rem) / 2)) 1.85rem;
		font-family: var(--font-display-stack);
		font-size: clamp(1.7rem, 2.6vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.92;
		text-decoration: none;
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.cta-go:hover {
		background: var(--color-accent-deep);
	}

	.cta-go:hover .arrow {
		transform: translateX(0.35rem);
	}

	@media (min-width: 56rem) {
		.cta-band {
			grid-template-columns: 1.45fr 0.7fr;
			min-height: 16rem;
		}

		.cta-main {
			padding-right: 3rem;
		}

		.cta-go {
			align-items: center;
			padding: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow {
			transition: none;
		}

		.cta-go:hover .arrow {
			transform: none;
		}
	}
</style>
