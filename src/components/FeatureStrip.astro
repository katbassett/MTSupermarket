---
/**
 * Soft market highlights ("Around the market").
 * Weekly Specials use the separate `weeklySpecials` array — do not put priced
 * placeholder specials here. See homepage reserved slot in index.astro.
 */
import { freshThisWeek } from '../data/features';
import Photo from './Photo.astro';
---

{
	freshThisWeek.length > 0 && (
		<section class="fresh" aria-labelledby="fresh-heading">
			<div class="container">
				<h2 id="fresh-heading" data-reveal>
					Around the market
				</h2>
				<ul>
					{freshThisWeek.map((feature, index) => (
						<li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
							<a href={feature.href}>
								<span class="fresh-media">
									<Photo
										src={feature.image}
										alt=""
										sizes="(min-width: 48rem) 28vw, 100vw"
										widths={[480, 720, 960]}
									/>
								</span>
								<span class="fresh-title">{feature.title}</span>
								{feature.priceLabel && <span class="fresh-price">{feature.priceLabel}</span>}
								<span class="fresh-text">{feature.summary}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.fresh {
		padding: clamp(1.35rem, 2.75vw, 2.15rem) 0 clamp(1.75rem, 3.25vw, 2.6rem);
		border-top: 1px solid var(--color-line);
	}

	h2 {
		font-size: clamp(1.7rem, 2.4vw, 2.15rem);
		line-height: 1;
	}

	ul {
		display: grid;
		gap: 1.1rem;
		margin: 1.15rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		min-width: 0;
	}

	a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.fresh-media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-lg);
		background: var(--color-paper-deep);
	}

	.fresh-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.fresh-title {
		display: block;
		margin-top: 0.8rem;
		font-family: var(--font-display-stack);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.fresh-price {
		display: block;
		margin-top: 0.3rem;
		color: var(--color-red);
		font-size: 0.95rem;
		font-weight: 800;
	}

	.fresh-text {
		display: block;
		margin-top: 0.35rem;
		color: var(--color-muted);
		font-size: 0.98rem;
		line-height: 1.4;
	}

	a:hover .fresh-title,
	a:focus-visible .fresh-title {
		color: var(--color-red);
	}

	a:hover .fresh-media :global(img),
	a:focus-visible .fresh-media :global(img) {
		transform: scale(1.03);
	}

	@media (min-width: 48rem) {
		ul {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fresh-media :global(img) {
			transition: none;
		}

		a:hover .fresh-media :global(img),
		a:focus-visible .fresh-media :global(img) {
			transform: none;
		}
	}
</style>
