---
import { formatAddress, nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div>
			<p class="footer-name">MT Supermarket</p>
			<p class="footer-note">Asian and international supermarket. Opening in San Antonio, {site.opening}.</p>
		</div>
		<div>
			<h2>Visit</h2>
			<p>
				<a href={site.mapsUrl}>{formatAddress()}</a>
			</p>
			<p>Open daily, {site.hoursLabel}</p>
			<p>Expected opening: {site.opening}</p>
		</div>
		<div>
			<h2>Contact</h2>
			<p><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
			{site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
		</div>
		<nav aria-label="Footer">
			<h2>Explore</h2>
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<div class="container footer-base">
		<p>© {year} MT Supermarket</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-ink-soft);
		color: var(--color-paper);
		padding: 3rem 0 1.5rem;
	}

	.footer-grid {
		display: grid;
		gap: 2rem;
	}

	.footer-name {
		font-family: var(--font-display-stack);
		font-size: 1.8rem;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	h2 {
		margin-bottom: 0.7rem;
		font-family: var(--font-body-stack);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	p + p,
	li + li {
		margin-top: 0.35rem;
	}

	a {
		color: inherit;
		text-underline-offset: 0.15em;
	}

	ul {
		list-style: none;
		padding: 0;
	}

	.footer-note {
		margin-top: 0.55rem;
		color: #e4d7c8;
		font-size: 0.95rem;
	}

	.footer-base {
		display: grid;
		gap: 0.35rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(243, 238, 228, 0.2);
		color: #e4d7c8;
		font-size: 0.92rem;
	}

	@media (min-width: 48rem) {
		.footer-grid {
			grid-template-columns: 1.3fr 1fr 1fr 0.8fr;
		}
	}
</style>
