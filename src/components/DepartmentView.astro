---
import type { Department } from '../data/departments';
import Hero from './Hero.astro';

interface Props {
	department: Department;
}

const { department } = Astro.props;
---

<Hero
	image={department.image}
	imageAlt={department.imageAlt}
	title={department.name}
	kicker="Department"
	detail={department.slug === 'seafood' ? 'Fresh · frozen · packaged · live' : undefined}
	size="page"
/>
<section class="section">
	<div class="container prose">
		{
			department.signLabel && (
				<p
					class:list={[
						'sign-label',
						department.signTone === 'red' ? 'sign-label-red' : 'sign-label-yellow',
						'dept-page-sign',
					]}
				>
					{department.signLabel}
				</p>
			)
		}
		<p>{department.description}</p>
		<h2>Highlights</h2>
		<ul class="highlight-list">
			{department.highlights.map((item) => <li>{item}</li>)}
		</ul>
		<div class="button-row">
			<a class="button button-primary" href="/departments">All departments</a>
			<a class="button button-secondary" href="/contact">Store information</a>
		</div>
	</div>
</section>

<style>
	.dept-page-sign {
		margin-bottom: 1rem;
	}

	h2 {
		margin-top: 2rem;
		font-size: clamp(2rem, 4vw, 2.8rem);
	}
</style>
