---
import { departments, type Department } from '../data/departments';
import Photo from './Photo.astro';

interface Props {
	department: Department;
}

const { department } = Astro.props;
const others = departments.filter((item) => item.slug !== department.slug);
const detail = department.slug === 'seafood' ? 'Fresh · frozen · packaged · live' : undefined;
---

<section class="dept-launch" aria-labelledby="dept-heading">
	<div class="dept-frame">
		<figure class:list={['dept-photo', department.slug]}>
			<Photo
				src={department.image}
				alt={department.imageAlt}
				sizes="(min-width: 64rem) 72vw, 100vw"
				loading="eager"
				fetchpriority="high"
				widths={[640, 960, 1200, 1600]}
			/>
		</figure>
		<div class="dept-panel">
			<p class="dept-kicker">Department</p>
			<h1 id="dept-heading">{department.name}</h1>
			{
				department.signLabel && (
					<p class="sign-label sign-label-yellow dept-sign">{department.signLabel}</p>
				)
			}
			{detail && <p class="dept-detail">{detail}</p>}
			<p class="dept-dek">{department.summary}</p>
			<div class="dept-actions">
				<a class="dept-cta" href="/departments">All departments</a>
				<a class="dept-link" href="/contact">
					Store info
					<span class="arrow" aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</div>
</section>

<section class="dept-about" id="about-department" aria-labelledby="about-dept-heading">
	<div class="container dept-about-wrap">
		<div class="dept-copy">
			<p class="kicker">In this department</p>
			<h2 id="about-dept-heading">What you'll find.</h2>
			<p>{department.description}</p>
			<a class="dept-text-cta" href="/careers">
				We're hiring
				<span class="arrow" aria-hidden="true">→</span>
			</a>
		</div>
		<ul class="dept-highlights" aria-label="Highlights">
			{
				department.highlights.map((item) => (
					<li>
						<span class="mark" aria-hidden="true" />
						{item}
					</li>
				))
			}
		</ul>
	</div>
</section>

<nav class="dept-more" aria-label="Other departments">
	<div class="container dept-more-inner">
		<p>Also shop</p>
		<ul>
			{
				others.map((item) => (
					<li>
						<a href={`/departments/${item.slug}`}>{item.name}</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<style>
	.kicker {
		color: var(--color-red);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.dept-launch {
		padding: 0 0 clamp(0.5rem, 1.5vw, 1rem);
	}

	.dept-frame {
		position: relative;
		width: min(92rem, calc(100% - 1.25rem));
		margin-inline: auto;
	}

	.dept-photo {
		position: relative;
		width: 100%;
		margin: 0;
		overflow: hidden;
		aspect-ratio: 5 / 4;
		border-radius: 0;
		background: var(--color-paper-deep);
		animation: dept-photo-in 2.2s ease both;
	}

	.dept-photo :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.produce :global(img) {
		object-position: center 40%;
	}

	.seafood :global(img) {
		object-position: center 58%;
	}

	.meat :global(img) {
		object-position: center 40%;
	}

	.grocery :global(img) {
		object-position: center 45%;
	}

	.dept-panel {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: calc(100% - 1rem);
		margin-top: -2.75rem;
		padding: clamp(1.25rem, 3.2vw, 1.75rem) clamp(0.85rem, 2vw, 1rem);
		border-radius: var(--radius-lg);
		background: var(--color-red);
		color: var(--color-cream);
		text-align: center;
	}

	.dept-panel > * {
		animation: dept-line-in 1.25s ease both;
	}

	.dept-kicker {
		color: var(--color-cream);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		animation-delay: 0.45s;
	}

	.dept-panel h1 {
		max-width: 10.5em;
		margin-top: 0.45rem;
		margin-inline: auto;
		color: var(--color-cream);
		font-size: clamp(2.35rem, 5vw, 3.1rem);
		line-height: 0.95;
		animation-delay: 0.7s;
	}

	.dept-sign {
		margin-top: 0.85rem;
		animation-delay: 0.95s;
	}

	.dept-detail {
		margin-top: 0.75rem;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		animation-delay: 0.95s;
	}

	.dept-dek {
		max-width: 22rem;
		margin-top: 0.75rem;
		margin-inline: auto;
		color: var(--color-cream);
		font-size: 1.02rem;
		line-height: 1.45;
		animation-delay: 1.1s;
	}

	.dept-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.65rem 1.15rem;
		margin-top: 1rem;
		animation-delay: 1.35s;
	}

	.dept-cta {
		position: relative;
		isolation: isolate;
		display: inline-flex;
		align-items: center;
		overflow: hidden;
		min-height: 2.85rem;
		padding: 0.65rem 1.1rem;
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-red);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 0.35s ease;
	}

	.dept-cta::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: inherit;
		background: var(--color-blue);
		transform: translateX(-105%);
		transition: transform 0.45s ease;
	}

	.dept-cta:hover::before,
	.dept-cta:focus-visible::before {
		transform: translateX(0);
	}

	.dept-cta:hover,
	.dept-cta:focus-visible {
		color: var(--color-cream);
	}

	.dept-link,
	.dept-text-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-cream);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.dept-link:hover,
	.dept-link:focus-visible {
		color: var(--color-blue);
	}

	.dept-text-cta {
		margin-top: 1.15rem;
		color: var(--color-red);
	}

	.dept-text-cta:hover,
	.dept-text-cta:focus-visible {
		color: var(--color-ink);
	}

	.arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.dept-link:hover .arrow,
	.dept-link:focus-visible .arrow,
	.dept-text-cta:hover .arrow,
	.dept-text-cta:focus-visible .arrow {
		transform: translateX(0.28rem);
	}

	.dept-about {
		background: var(--color-warm);
		padding: clamp(2.25rem, 4.5vw, 3.75rem) 0;
	}

	.dept-about-wrap {
		display: grid;
		gap: 1.5rem;
		align-items: start;
		min-width: 0;
	}

	.dept-copy h2 {
		margin-top: 0.4rem;
		max-width: 14ch;
		font-size: clamp(1.75rem, 2.4vw, 2.2rem);
		line-height: 1.08;
	}

	.dept-copy p:not(.kicker) {
		max-width: 38rem;
		margin-top: 0.9rem;
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.dept-highlights {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dept-highlights li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
		align-items: start;
		padding: 0.95rem 1rem;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.mark {
		width: 0.55rem;
		height: 0.55rem;
		margin-top: 0.35rem;
		border-radius: 0.1rem;
		background: var(--color-yellow);
	}

	.dept-more {
		display: flex;
		align-items: center;
		min-height: 3.35rem;
		background: var(--color-surface);
		border-block: 1px solid var(--color-line);
		padding: 1.1rem 0;
	}

	.dept-more-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		column-gap: 0;
		row-gap: 0.75rem;
		/* Do not set width: 100% — it overrides .container and goes edge-to-edge */
	}

	.dept-more p {
		flex: 0 0 auto;
		margin: 0 0.9rem 0 0;
		padding: 0 0.9rem 0 0.02em;
		border-right: 1px solid var(--color-line);
		color: var(--color-red);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.dept-more ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		flex: 1 1 auto;
		gap: 0.65rem 0;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dept-more li {
		display: flex;
		align-items: center;
		line-height: 1.2;
	}

	.dept-more li:not(:last-child) {
		margin-right: 0.9rem;
		padding-right: 0.9rem;
		border-right: 1px solid var(--color-line);
	}

	.dept-more a {
		font-size: 0.98rem;
		font-weight: 800;
		line-height: 1.2;
		text-decoration: none;
	}

	.dept-more a:hover,
	.dept-more a:focus-visible {
		color: var(--color-red);
	}

	@media (max-width: 47.99rem) {
		.dept-more {
			padding: 1.25rem 0.85rem 1.35rem;
		}

		.dept-more-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
			padding-inline: 0.35rem;
		}

		.dept-more p {
			margin: 0;
			padding: 0;
			border-right: 0;
		}

		.dept-more ul {
			width: 100%;
			gap: 0.75rem 1.15rem;
		}

		.dept-more li:not(:last-child) {
			margin-right: 0;
			padding-right: 0;
			border-right: 0;
		}
	}

	@keyframes dept-photo-in {
		from {
			opacity: 0;
			transform: scale(1.035);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes dept-line-in {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 63.99rem) {
		.dept-frame {
			width: 100%;
			margin-inline: 0;
		}

		.dept-photo {
			aspect-ratio: 3 / 4;
		}

		.dept-panel {
			position: absolute;
			top: 50%;
			left: 50%;
			width: min(78%, 17.25rem);
			margin-top: 0;
			padding: 1.2rem 0.72rem;
			transform: translate(-50%, -50%);
		}

		.dept-panel h1 {
			font-size: 2.1rem;
		}

		.dept-dek {
			font-size: 0.95rem;
		}
	}

	@media (min-width: 64rem) {
		.dept-frame {
			--panel: 34%;
			--overlap: clamp(4rem, 5.5vw, 7.5rem);
		}

		.dept-photo {
			width: calc(100% - var(--panel) + var(--overlap));
			margin-left: auto;
			aspect-ratio: 16 / 9;
			border-radius: var(--radius-lg);
		}

		.dept-panel {
			position: absolute;
			top: 50%;
			left: 0;
			width: var(--panel);
			max-width: 34%;
			margin-top: 0;
			padding: clamp(1.35rem, 1.65vw, 1.85rem) clamp(0.85rem, 1vw, 1rem);
			transform: translateY(-50%);
		}

		.dept-panel h1 {
			font-size: clamp(2.4rem, 2.8vw, 3.25rem);
		}

		.dept-about-wrap {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 2.75rem;
			align-items: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dept-photo,
		.dept-panel > *,
		.arrow,
		.dept-cta::before {
			animation: none;
			transition: none;
		}

		.dept-link:hover .arrow,
		.dept-link:focus-visible .arrow,
		.dept-text-cta:hover .arrow,
		.dept-text-cta:focus-visible .arrow {
			transform: none;
		}
	}
</style>
