---
import type { Department } from '../data/departments';
import Hero from './Hero.astro';

interface Props {
	department: Department;
}

const { department } = Astro.props;
---

<Hero
	image={department.image}
	imageAlt={department.imageAlt}
	title={department.name}
	kicker="Department"
	size="page"
/>
<section class="section">
	<div class="container prose">
		<p>{department.description}</p>
		<h2>Highlights</h2>
		<ul class="highlight-list">
			{department.highlights.map((item) => <li>{item}</li>)}
		</ul>
		<div class="button-row">
			<a class="button button-primary" href="/departments">All departments</a>
			<a class="button button-secondary" href="/contact">Store information</a>
		</div>
	</div>
</section>

<style>
	h2 {
		margin-top: 2rem;
		font-size: clamp(2rem, 4vw, 2.8rem);
	}
</style>
