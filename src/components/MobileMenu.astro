---
import { isCurrentPath, nav } from '../data/site';

const pathname = Astro.url.pathname;
---

<details class="mobile-nav" data-mobile-menu>
	<summary class="menu-toggle">Menu</summary>
	<nav aria-label="Mobile">
		<ul>
			{
				nav.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}>
							{item.label}
							{item.hint && <span class="nav-hint"> · {item.hint}</span>}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</details>

<script>
	const menu = document.querySelector('[data-mobile-menu]');
	if (menu instanceof HTMLDetailsElement) {
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				menu.open = false;
				menu.querySelector('summary')?.focus();
			}
		});
	}
</script>

<style>
	.mobile-nav {
		flex: 0 0 auto;
		align-self: center;
		color: var(--color-ink);
	}

	.mobile-nav nav {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		z-index: 40;
		background: var(--color-red);
		color: var(--color-bg);
	}

	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0;
		color: var(--color-red);
		list-style: none;
		cursor: pointer;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1;
		text-transform: uppercase;
	}

	.menu-toggle::-webkit-details-marker {
		display: none;
	}

	.mobile-nav ul {
		list-style: none;
		padding: 0 0 0.35rem;
	}

	.mobile-nav a {
		display: block;
		padding: 0.85rem 1rem;
		border-top: 1px solid rgb(251 250 247 / 0.18);
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-decoration: none;
		text-transform: uppercase;
	}

	@media (min-width: 48rem) {
		.mobile-nav a {
			padding-inline: 1.5rem;
		}
	}

	.mobile-nav a[aria-current='page'] {
		color: var(--color-yellow);
	}

	.nav-hint {
		color: var(--color-yellow);
	}

	@media (min-width: 62rem) {
		.mobile-nav {
			display: none;
		}
	}
</style>
