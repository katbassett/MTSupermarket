---
import { Image } from 'astro:assets';
import logoIcon from '../assets/images/logos/mt-icon.png';
import logoWordmark from '../assets/images/logos/mt-wordmark.png';
import { formatAddressLine, isCurrentPath, nav, site } from '../data/site';
import MobileMenu from './MobileMenu.astro';

const pathname = Astro.url.pathname;
---

<header class="site-header" data-site-header>
	<div class="utility">
		<div class="container utility-inner">
			<p><a href={site.mapsUrl}>{formatAddressLine()}</a></p>
			<p class="utility-hours">{site.hoursPhrase}</p>
			<p><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
		</div>
	</div>
	<div class="masthead">
		<div class="container masthead-inner">
			<a class="wordmark" href="/" aria-label="MT Supermarket, home">
				<Image
					class="logo-icon"
					src={logoIcon}
					alt=""
					width={72}
					height={73}
					densities={[1, 2]}
				/>
				<Image
					class="logo-wordmark"
					src={logoWordmark}
					alt=""
					width={220}
					height={42}
					densities={[1, 2]}
				/>
			</a>
			<p class="masthead-meta">
				<span>San Antonio</span>
				<span>Opening {site.opening}</span>
			</p>
			{/* Mobile: Menu sits on the same row as the logo */}
			<MobileMenu />
		</div>
	</div>
	<div class="nav-bar">
		<div class="container nav-inner">
			<a class="compact-wordmark" href="/" aria-label="MT Supermarket, home">
				<Image
					class="compact-logo-icon"
					src={logoIcon}
					alt=""
					width={34}
					height={35}
					densities={[1, 2]}
				/>
			</a>
			<nav class="desktop-nav" aria-label="Primary">
				<ul>
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}
								>
									{item.label}
									{item.hint && <span class="nav-hint"> · {item.hint}</span>}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector('[data-site-header]');
	if (header) {
		const threshold = 48;
		let ticking = false;

		const sync = () => {
			header.classList.toggle('is-compact', window.scrollY > threshold);
			ticking = false;
		};

		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(sync);
			}
		};

		sync();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	:global(html:has(.site-header.is-compact)) {
		--header-height: 2.875rem;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
	}

	.utility,
	.masthead {
		overflow: hidden;
		max-height: 7rem;
		opacity: 1;
		transition:
			max-height 0.35s ease,
			opacity 0.28s ease;
	}

	.masthead {
		max-height: 6rem;
	}

	.site-header.is-compact .utility,
	.site-header.is-compact .masthead {
		max-height: 0;
		opacity: 0;
		pointer-events: none;
	}

	.compact-wordmark {
		display: none;
		flex: 0 0 auto;
		align-items: center;
		line-height: 0;
		text-decoration: none;
	}

	.compact-logo-icon {
		display: block;
		width: 2.05rem;
		height: auto;
	}

	.site-header.is-compact .compact-wordmark {
		display: flex;
	}

	.site-header.is-compact .nav-inner {
		gap: clamp(0.85rem, 2vw, 1.75rem);
		min-height: 2.875rem;
	}

	.site-header.is-compact .desktop-nav {
		flex: 1;
		width: auto;
	}

	.site-header.is-compact .desktop-nav ul {
		justify-content: flex-start;
		gap: clamp(0.85rem, 1.6vw, 1.65rem);
		width: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.utility,
		.masthead {
			transition: none;
		}
	}

	.utility {
		background: var(--color-cream);
		color: var(--color-ink);
		border-bottom: 1px solid var(--color-line);
	}

	.utility-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.15rem 1.25rem;
		min-height: 2rem;
		padding: 0.2rem 0;
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.utility-hours {
		color: var(--color-blue);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.utility a {
		color: inherit;
		text-decoration: none;
	}

	.utility a:hover,
	.utility a:focus-visible {
		color: var(--color-blue);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.masthead {
		background: var(--color-bg);
		color: var(--color-ink);
	}

	.masthead-inner {
		display: flex;
		align-items: center;
		gap: 0.85rem 1.15rem;
		min-height: 5rem;
		padding-block: 0.55rem;
	}

	.masthead-inner :global(.mobile-nav) {
		flex: 0 0 auto;
		margin-left: auto;
	}

	.wordmark {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	.logo-icon {
		display: block;
		flex: 0 0 auto;
		width: clamp(2.6rem, 7vw, 3.55rem);
		height: auto;
	}

	.logo-wordmark {
		display: block;
		flex: 0 1 auto;
		width: clamp(8.5rem, 28vw, 13.75rem);
		height: auto;
	}

	.masthead-meta {
		display: grid;
		justify-items: end;
		gap: 0.18rem;
		color: var(--color-muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.25;
		text-align: right;
		text-transform: uppercase;
	}

	@media (min-width: 62rem) {
		.masthead-inner {
			justify-content: space-between;
		}

		.masthead-meta {
			margin-left: auto;
		}
	}

	.nav-bar {
		background: var(--color-red);
		color: var(--color-bg);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		min-height: 2.875rem;
	}

	@media (max-width: 61.99rem) {
		/* Logo + Menu share the masthead row; red nav bar is desktop-only here */
		.nav-bar {
			display: none;
		}

		.masthead-meta {
			display: none;
		}

		/* Kill the global .container side inset (100% - 2rem / 3rem) */
		:global(.site-header .container) {
			width: 100%;
			max-width: none;
			margin-inline: 0;
			padding-inline: 0;
		}

		.utility-inner,
		.masthead-inner {
			width: 100%;
			padding-inline: 0;
		}

		.wordmark {
			padding-left: 0;
			margin-left: 0;
		}

		.logo-icon {
			/* PNG has a little transparent margin around the circle */
			margin-left: -0.2rem;
		}

		.masthead-inner :global(.mobile-nav) {
			padding-right: 0.15rem;
			margin-right: 0;
		}

		.site-header.is-compact .masthead {
			max-height: 4.75rem;
			opacity: 1;
			pointer-events: auto;
		}

		:global(html:has(.site-header.is-compact)) {
			--header-height: 4.75rem;
		}

		.logo-wordmark {
			width: clamp(7.5rem, 42vw, 11rem);
		}
	}

	.desktop-nav {
		display: none;
		width: 100%;
	}

	.desktop-nav ul {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		list-style: none;
		padding: 0;
	}

	.desktop-nav a {
		display: inline-block;
		padding: 0.35rem 0 0.2rem;
		border-bottom: 2px solid transparent;
		color: var(--color-cream);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
	}

	.desktop-nav a:hover,
	.desktop-nav a:focus-visible,
	.desktop-nav a[aria-current='page'] {
		border-bottom-color: var(--color-blue);
	}

	.nav-hint {
		color: var(--color-yellow);
	}

	@media (min-width: 48rem) {
		.utility-inner {
			flex-wrap: nowrap;
			justify-content: space-between;
			min-height: 2rem;
			padding: 0;
			font-size: 0.75rem;
		}

		.utility-inner p {
			white-space: nowrap;
		}

		.masthead-inner {
			min-height: 5rem;
		}
	}

	@media (max-width: 40rem) {
		.masthead-meta {
			font-size: 0.6rem;
			letter-spacing: 0.08em;
		}
	}

	@media (min-width: 62rem) {
		.desktop-nav {
			display: block;
		}
	}
</style>
