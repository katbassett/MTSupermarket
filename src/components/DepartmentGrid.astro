---
import { departments, type Department } from '../data/departments';
import DepartmentCard from './DepartmentCard.astro';

const order: Department['slug'][] = ['produce', 'seafood', 'meat', 'grocery'];
const tiles = [...departments].sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
---

<ul class="dept-grid">
	{
		tiles.map((department) => (
			<li>
				<DepartmentCard department={department} />
			</li>
		))
	}
</ul>

<style>
	/* Even retail grid. */
	.dept-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.75rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dept-grid > li {
		min-width: 0;
		list-style: none;
	}

	.dept-grid > li::marker {
		content: none;
	}

	@media (min-width: 40rem) {
		.dept-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem 1.5rem;
		}
	}
</style>
